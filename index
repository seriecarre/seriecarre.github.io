const scrollSquare =
    document.querySelector(".scroll-square");


function updateSquare() {

    const scrollTop =
        window.scrollY;

    const documentHeight =
        document.documentElement.scrollHeight -
        window.innerHeight;

    let progress = 0;

    if (documentHeight > 0) {

        progress =
            scrollTop / documentHeight;

    }

    const minSize = 8;
    const maxSize = 70;

    const size =
        minSize +
        ((maxSize - minSize) * progress);

    scrollSquare.style.width =
        size + "px";

    scrollSquare.style.height =
        size + "px";

}


window.addEventListener(
    "scroll",
    updateSquare,
    { passive: true }
);

window.addEventListener(
    "resize",
    updateSquare
);

updateSquare();


