===================================================== */

function obtenirNombrePropositions() {

    const valeur =
        localStorage.getItem(
            CLE_PROPOSITIONS
        );

    if (valeur === null) {
        return 0;
    }

    const nombre =
        parseInt(
            valeur,
            10
        );

    if (isNaN(nombre)) {
        return 0;
    }

    return nombre;
}


/* =====================================================
   METTRE À JOUR LE COMPTEUR
===================================================== */

function mettreAJourCompteur() {

    const utilisees =
        obtenirNombrePropositions();

    const restantes =
        Math.max(
            NOMBRE_CARRES - utilisees,
            0
        );

    compteur.textContent =
        restantes;


    if (restantes <= 0) {

        form.style.display =
            "none";

        blocked.style.display =
            "block";

    } else {

        form.style.display =
            "block";

        blocked.style.display =
            "none";

    }

}


mettreAJourCompteur();


/* =====================================================
   ENVOI DU FORMULAIRE
===================================================== */

form.addEventListener(
    "submit",
    async function(event) {

        event.preventDefault();


        const utilisees =
            obtenirNombrePropositions();

        const restantes =
            NOMBRE_CARRES -
            utilisees;


        if (restantes <= 0) {

            mettreAJourCompteur();

            return;

        }


        /* ---------------------------------------------
           CONFIRMATION FINALE
        --------------------------------------------- */

        const confirmation =
            confirm(

                "Êtes-vous certain de vouloir envoyer " +
                "cette proposition ?\n\n" +

                "Cette tentative sera comptabilisée " +
                "et ne pourra pas être récupérée.\n\n" +

                "Le Carré choisi sera enregistré " +
                "avec votre proposition."

            );


        if (!confirmation) {

            return;

        }


        submitButton.disabled =
            true;

        submitButton.textContent =
            "ENVOI EN COURS...";


        status.className =
            "form-status";

        status.textContent =
            "Envoi en cours...";

        status.style.display =
            "block";


        const data =
            new FormData(form);


        /* ---------------------------------------------
           INFORMATIONS TRANSMISES AVEC LE MAIL
        --------------------------------------------- */

        data.append(
            "version_du_projet",
            VERSION_CARRE
        );

        data.append(
            "numero_de_proposition",
            utilisees + 1
        );

        data.append(
            "nombre_de_carres",
            NOMBRE_CARRES
        );

        data.append(
            "date_proposition",
            new Date().toLocaleString(
                "fr-FR"
            )
        );


        try {

            const response =
                await fetch(
                    form.action,
                    {
                        method: "POST",

                        body: data,

                        headers: {
                            "Accept":
                                "application/json"
                        }
                    }
                );


            if (response.ok) {


                /* -------------------------------------
                   L'ENVOI A RÉUSSI :
                   ON CONSOMME UNE PROPOSITION
                ------------------------------------- */

                const nouveauNombre =
                    utilisees + 1;


                localStorage.setItem(
                    CLE_PROPOSITIONS,
                    nouveauNombre
                );


                const nouvellesRestantes =
                    NOMBRE_CARRES -
                    nouveauNombre;


                status.className =
                    "form-status success";


                if (nouvellesRestantes > 0) {

                    status.textContent =
                        "Votre proposition a bien été enregistrée. " +
                        "Il vous reste " +
                        nouvellesRestantes +
                        " proposition(s).";

                } else {

                    status.textContent =
                        "Votre proposition a bien été enregistrée. " +
                        "Vous avez utilisé toutes vos propositions " +
                        "disponibles.";

                }


                form.reset();


                mettreAJourCompteur();


                submitButton.disabled =
                    false;

                submitButton.textContent =
                    "CONFIRMER ET ENVOYER";


            } else {


                submitButton.disabled =
                    false;

                submitButton.textContent =
                    "CONFIRMER ET ENVOYER";


                status.className =
                    "form-status error";

                status.textContent =
                    "Une erreur est survenue. " +
                    "Votre proposition n'a pas été comptabilisée. " +
                    "Vous pouvez réessayer.";

            }


        } catch (error) {


            submitButton.disabled =
                false;

            submitButton.textContent =
                "CONFIRMER ET ENVOYER";


            status.className =
                "form-status error";

            status.textContent =
                "Impossible d'envoyer la proposition. " +
                "Vérifiez votre connexion et réessayez.";

        }

    }
);

</script>

